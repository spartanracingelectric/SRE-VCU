; sensors.c	   193  
; sensors.c	   194  /*****************************************************************************
; sensors.c	   195  * Output Calculations
; sensors.c	   196  ******************************************************************************
; sensors.c	   197  * Takes properties from devices (such as raw sensor values [ohms, voltage],
; sensors.c	   198  * MCU/BMS CAN messages, etc), performs calculations with that data, and updates
; sensors.c	   199  * the relevant objects' properties.
; sensors.c	   200  *
; sensors.c	   201  * This includes sensor calculations, motor controller control calculations,
; sensors.c	   202  * traction control, BMS/safety calculations, etc.
; sensors.c	   203  * (May need to split this up later)
; sensors.c	   204  *
; sensors.c	   205  * For example: GetThrottlePosition() takes the raw TPS voltages from the TPS
; sensors.c	   206  * sensor objects and returns the throttle pedal percent.  This function does
; sensors.c	   207  * NOT update the sensor objects, but it would be acceptable for another
; sensors.c	   208  * function in this file to do so.
; sensors.c	   209  *
; sensors.c	   210  ******************************************************************************
; sensors.c	   211  * To-do:
; sensors.c	   212  *
; sensors.c	   213  ******************************************************************************
; sensors.c	   214  * Revision history:
; sensors.c	   215  * 2015-11-16 - Rusty Pedrosa -
; sensors.c	   216  *****************************************************************************/

	; Module end
	.end
