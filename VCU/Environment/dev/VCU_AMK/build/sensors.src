; sensors.c	   190  
; sensors.c	   191  /*****************************************************************************
; sensors.c	   192  * Output Calculations
; sensors.c	   193  ******************************************************************************
; sensors.c	   194  * Takes properties from devices (such as raw sensor values [ohms, voltage],
; sensors.c	   195  * MCU/BMS CAN messages, etc), performs calculations with that data, and updates
; sensors.c	   196  * the relevant objects' properties.
; sensors.c	   197  *
; sensors.c	   198  * This includes sensor calculations, motor controller control calculations,
; sensors.c	   199  * traction control, BMS/safety calculations, etc.
; sensors.c	   200  * (May need to split this up later)
; sensors.c	   201  *
; sensors.c	   202  * For example: GetThrottlePosition() takes the raw TPS voltages from the TPS
; sensors.c	   203  * sensor objects and returns the throttle pedal percent.  This function does
; sensors.c	   204  * NOT update the sensor objects, but it would be acceptable for another
; sensors.c	   205  * function in this file to do so.
; sensors.c	   206  *
; sensors.c	   207  ******************************************************************************
; sensors.c	   208  * To-do:
; sensors.c	   209  *
; sensors.c	   210  ******************************************************************************
; sensors.c	   211  * Revision history:
; sensors.c	   212  * 2015-11-16 - Rusty Pedrosa -
; sensors.c	   213  *****************************************************************************/

