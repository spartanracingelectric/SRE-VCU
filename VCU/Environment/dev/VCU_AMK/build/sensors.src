code_max	.section	code, cluster 'max', new
	.global	_max

; sensors.c	   195  
; sensors.c	   196  /*****************************************************************************
; sensors.c	   197  * Output Calculations
; sensors.c	   198  ******************************************************************************
; sensors.c	   199  * Takes properties from devices (such as raw sensor values [ohms, voltage],
; sensors.c	   200  * MCU/BMS CAN messages, etc), performs calculations with that data, and updates
; sensors.c	   201  * the relevant objects' properties.
; sensors.c	   202  *
; sensors.c	   203  * This includes sensor calculations, motor controller control calculations,
; sensors.c	   204  * traction control, BMS/safety calculations, etc.
; sensors.c	   205  * (May need to split this up later)
; sensors.c	   206  *
; sensors.c	   207  * For example: GetThrottlePosition() takes the raw TPS voltages from the TPS
; sensors.c	   208  * sensor objects and returns the throttle pedal percent.  This function does
; sensors.c	   209  * NOT update the sensor objects, but it would be acceptable for another
; sensors.c	   210  * function in this file to do so.
; sensors.c	   211  *
; sensors.c	   212  ******************************************************************************
; sensors.c	   213  * To-do:
; sensors.c	   214  *
; sensors.c	   215  ******************************************************************************
; sensors.c	   216  * Revision history:
; sensors.c	   217  * 2015-11-16 - Rusty Pedrosa -
; sensors.c	   218  *****************************************************************************/
; sensors.c	   219  
; sensors.c	   220  /*****************************************************************************
; sensors.c	   221  * Math Utility Functions (consolidated from mathFunctions.c)
; sensors.c	   222  *****************************************************************************/
; sensors.c	   223  
; sensors.c	   224  // A utility function to get maximum of two integers
; sensors.c	   225  ubyte2 max(ubyte2 a, ubyte2 b)
